# ====================================================================
# RU Metrics - Variáveis de Ambiente de Exemplo (.env.example)
# Compatível com Desenvolvimento Local e Publicação na Vercel
# ====================================================================

# --- Backend Configurações ---
NODE_ENV=production
PORT=3002

# Conexão com o PostgreSQL (Neon Serverless Postgres)
# URL com pooling (recomendada para Serverless / Vercel):
DATABASE_URL="postgresql://user:pass@ep-cool-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require"
# URL direta sem pooling (utilizada para migrações e prisma db push):
DATABASE_URL_UNPOOLED="postgresql://user:pass@ep-cool.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# Chave secreta para assinatura dos tokens JWT de autenticação
JWT_SECRET="chave-secreta-producao-ru-metrics-ufes-2026-substituir"
JWT_EXPIRES_IN="7d"

# Configuração de CORS (URLs autorizadas separadas por vírgula ou * para permitir o domínio da Vercel)
CORS_ORIGIN="https://*.vercel.app,http://localhost:5173"

# --- Frontend Configurações ---
# Em produção na Vercel (onde API e Frontend compartilham o mesmo domínio), deixe como /api
# Se o backend for hospedado em outro servidor (ex.: Railway/Render), aponte a URL completa:
# VITE_API_URL="https://seu-backend.railway.app/api"
VITE_API_URL="/api"
