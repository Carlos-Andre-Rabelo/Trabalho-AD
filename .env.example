# ====================================================================
# RU Metrics - Variáveis de Ambiente de Exemplo (.env.example)
# Copie este arquivo como .env na raiz ou configure backend/.env e frontend/.env
# ====================================================================

# --- Backend Configurações ---
NODE_ENV=development
PORT=3001

# Conexão com o PostgreSQL (local via Docker Compose ou servidor remoto)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ru_metrics?schema=public"

# Chave secreta para assinatura dos tokens JWT de autenticação
JWT_SECRET="dev-secret-key-ru-metrics-academico-2026-substituir-em-producao"
JWT_EXPIRES_IN="7d"

# Configuração de CORS (URL do frontend em desenvolvimento/produção)
CORS_ORIGIN="http://localhost:5173"

# --- Frontend Configurações ---
VITE_API_URL="http://localhost:3001/api"
